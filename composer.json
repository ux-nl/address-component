{
    "name": "chargit/address-component",
    "description": "Filament address form component with postcode lookup for NL, BE, DE, FR, LU",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "baspa/zip-code-location-lookup": "^0.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Chargit\\AddressComponent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chargit\\AddressComponent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chargit\\AddressComponent\\AddressComponentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
