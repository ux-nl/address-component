{
    "name": "ux-nl/address-component",
    "description": "Filament address form component with postcode lookup for NL, BE, DE, FR, LU",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/ux-nl/address-component",
    "authors": [
        {
            "name": "Mark van Eijk",
            "homepage": "https://ux.nl",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ux-nl/zip-code-location-lookup": "^0.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Chargit\\AddressComponent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chargit\\AddressComponent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chargit\\AddressComponent\\AddressComponentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:ux-nl/zip-code-location-lookup.git"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
